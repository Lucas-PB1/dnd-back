{
  "name": "dnd-api",
  "version": "1.0.0",
  "private": true,
  "description": "PostgreSQL — catálogo PHB 2024 + API NestJS",
  "license": "ISC",
  "scripts": {
    "build": "npx nest build && npx tsc-alias -p tsconfig.json",
    "start": "nest start",
    "start:dev": "node scripts/ops/clean-dist-shadows.mjs && nest start --watch",
    "start:prod": "node dist/main",
    "vercel:dev": "vercel dev --listen 3000",
    "vercel:smoke": "node scripts/ops/vercel-local-smoke.mjs",
    "smoke:health": "node scripts/ops/smoke-health.mjs",
    "measure:latency": "node scripts/ops/measure-latency.mjs",
    "measure:character": "node scripts/ops/measure-character-once.mjs",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:supabase:start": "npx supabase start",
    "db:supabase:stop": "npx supabase stop",
    "db:supabase:status": "npx supabase status",
    "db:reset": "node scripts/db/dev-reset.mjs",
    "db:migrate": "node scripts/db/run-migrations.mjs",
    "db:seed": "node scripts/db/run-seeds.mjs",
    "db:validate:sequences": "node scripts/db/validate-sql-sequences.mjs",
    "db:setup": "npm run db:validate:sequences && npm run db:reset && npm run db:migrate && npm run db:seed && npm run db:migrate",
    "db:migrate:supabase": "node scripts/db/run-migrations.mjs --target=supabase",
    "db:migrate:all": "node scripts/db/run-migrations.mjs --target=all",
    "db:seed:supabase": "node scripts/db/run-seeds.mjs --target=supabase",
    "db:seed:all": "node scripts/db/run-seeds.mjs --target=all",
    "db:setup:all": "npm run db:setup && node scripts/db/dev-reset.mjs --target=supabase --confirm && npm run db:migrate:supabase && npm run db:seed:supabase",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:e2e": "jest --config ./test/jest-e2e.config.js --runInBand"
  },
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.12",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.12",
    "@nestjs/platform-express": "^11.0.12",
    "@nestjs/swagger": "^11.4.5",
    "@nestjs/typeorm": "^11.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.22.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "tsconfig-paths": "^4.2.0",
    "typeorm": "^0.3.22"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.6",
    "@nestjs/testing": "^11.1.27",
    "@types/express": "^5.0.1",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.14.0",
    "@types/supertest": "^7.2.0",
    "jest": "^30.4.2",
    "sharp": "^0.35.4",
    "supabase": "^2.116.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.11",
    "tsc-alias": "^1.9.1",
    "typescript": "^5.8.3",
    "vercel": "^54.20.1"
  }
}
