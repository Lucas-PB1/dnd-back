# Banco **local** (iteração rápida)
# Preferência: Supabase local → npm run db:supabase:start → status mostra a URL (porta ~54322)
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Alternativa: só Postgres → npm run db:up
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Cloud Supabase — só para --target=supabase / db:setup:all (não use como DATABASE_URL)
# SUPABASE_DATABASE_URL=postgresql://postgres.[ref]:[pass]@aws-N-[region].pooler.supabase.com:5432/postgres
SUPABASE_DATABASE_URL=

# Supabase Auth (API Nest — projeto cloud ou URL local do `supabase status`)
SUPABASE_URL=https://your-project.supabase.co

# App
FRONTEND_URL=http://localhost:3001
PORT=3000
NODE_ENV=development

# --- Vercel (Production / Preview) ---
# DATABASE_URL = transaction pooler (6543), NÃO a URL direct 5432:
# postgresql://postgres.[ref]:[pass]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
# SUPABASE_URL = https://[ref].supabase.co
# FRONTEND_URL = https://seu-front.vercel.app
# NODE_ENV = production
